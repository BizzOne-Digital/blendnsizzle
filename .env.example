MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/blendnsizzle
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@blendnsizzle.com
ADMIN_PASSWORD=replace-with-a-strong-password
